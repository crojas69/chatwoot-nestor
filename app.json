{
  "name": "Smartbot de IABOT",
  "description": "IABOT Smartbot",
  "website": "https://smartwoot.iabot.com.co/",
  "repository": "https://github.com/crojas69/smartbotcw",
  "logo": "/brand-assets/logo_thumbnail.svg",
  "keywords": [
    "whatsapp chat crm",
    "smartchat",
    "iabot"
  ],
  "success_url": "/",
  "env": {
    "SECRET_TOKEN": {
      "description": "A secret key for verifying the integrity of signed cookies.",
      "generator": "secret"
    },
    "RACK_ENV": {
      "description": "Environment for rack middleware.",
      "value": "production"
    },
    "RAILS_ENV": {
      "description": "Environment for rails middleware.",
      "value": "production"
    },
    "FRONTEND_URL": {
      "description": "Public root URL of the SMARTBOT installation. This will be used in the emails.",
      "value": "https://smartwoot.iabot.com.co/"
    },
    "INSTALLATION_ENV": {
      "description": "Installation method used for SMARTBOT.",
      "value": "heroku"
    },
    "REDIS_OPENSSL_VERIFY_MODE":{
      "description": "OpenSSL verification mode for Redis connections. ref https://help.heroku.com/HC0F8CUS/redis-connection-issues",
      "value": "none"
    },
   "ENABLE_ENTERPRISE": {
      "description": "Enable enterprise features",
      "value": "true"
    },
    "ENABLE_BRANDING": {
      "description": "Enable white-label branding",
      "value": "true"
    },
    "INSTALLATION_NAME": {
      "value": "Smartbot de IABOT"
    },
    "LOGO": {
      "value": "/brand-assets/logo.svg"
    },
    "LOGO_DARK": {
      "value": "/brand-assets/logo_dark.svg"
    },
    "LOGO_THUMBNAIL": {
      "value": "/brand-assets/logo_thumbnail.svg"
    },
    "BRAND_URL": {
      "value": "https://smartwoot.iabot.com.co/"
    },
    "WIDGET_BRAND_URL": {
      "value": "https://smartwoot.iabot.com.co/"
    },
    "BRAND_NAME": {
      "value": "IABOT"
    },
    "TERMS_URL": {
      "value": "https://smartwoot.iabot.com.co/terms-of-service"
    },
    "PRIVACY_URL": {
      "value": "https://smartwoot.iabot.com.co/privacy-policy"
    },
    "DISPLAY_MANIFEST": {
      "value": "true"
    }
  },
  "formation": {
    "web": {
      "quantity": 1,
      "size": "basic"
    },
    "worker": {
      "quantity": 1,
      "size": "basic"
    }
  },
  "stack": "heroku-20",
  "image": "heroku/ruby",
  "addons": [
    {
      "plan": "heroku-redis:mini"
    },
    {
      "plan": "heroku-postgresql:essential-0"
    }
  ],
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    },
    {
      "url": "heroku/ruby"
    }
  ],
  "environments": {
    "test": {
      "scripts": {
        "test": "bundle exec rake test"
      }
    },
    "review": {
      "scripts": {
        "postdeploy": "bundle exec rails db:seed"
      }
    }
  }
}
